# OpenRouter 服务端密钥。不要把真实值提交到仓库。
OPENROUTER_API_KEY=sk-or-v1-replace-me

# 访问你自己的中转站时使用的密钥。客户端填这个，不填 OpenRouter 的密钥。
RELAY_API_KEY=replace-with-a-long-random-local-token

# 允许调用的 OpenRouter 模型，多个模型用英文逗号分隔。
ALLOWED_MODELS=openrouter/free,qwen/qwen3-coder:free,baidu/cobuddy:free,openrouter/owl-alpha,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,poolside/laguna-m.1:free,poolside/laguna-xs.2:free
FALLBACK_MODELS=qwen/qwen3-coder:free,openrouter/free

# 本地服务端口。
PORT=3000

# 可选：OpenRouter 侧用于显示来源。
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Local OpenRouter Relay

# 可选：最大请求体大小，默认 1048576，也就是 1 MB。
MAX_BODY_BYTES=1048576
